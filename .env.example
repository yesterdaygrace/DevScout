# ═══════════════════════════════════════════════════
# Client Configuration (Vite SPA)
# ═══════════════════════════════════════════════════
# Get from: Supabase Dashboard → Project → Settings → API
# Note: Never expose client secrets or private tokens with VITE_ prefix.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# GitHub OAuth is configured directly inside the Supabase Dashboard
# (Authentication → Providers → GitHub) with your GitHub OAuth App credentials.
# Do NOT store GitHub client secrets in client-side Vite environment variables.

# ═══════════════════════════════════════════════════
# Server Backend Configuration (Hono / Vercel Serverless)
# ═══════════════════════════════════════════════════
# GitHub Personal Access Token (Server-side ONLY)
# Used by backend proxy (/api/github/*) to raise GitHub rate limit from 60 to 5,000 req/hr.
# Keep this secret. Do NOT prefix with VITE_.
GITHUB_PAT=
PORT=4001
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4173
