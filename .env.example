# ═══════════════════════════════════════════════════
# Supabase Configuration
# ═══════════════════════════════════════════════════
# Get from: Supabase Dashboard → Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ═══════════════════════════════════════════════════
# GitHub OAuth (for "Sign in with GitHub" button)
# ═══════════════════════════════════════════════════
# Get from: https://github.com/settings/developers → New OAuth App
# Authorization callback URL (in GitHub OAuth App settings):
#   https://<your-project>.supabase.co/auth/v1/callback
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_CLIENT_SECRET=

# ═══════════════════════════════════════════════════
# GitHub Personal Access Token (optional)
# ═══════════════════════════════════════════════════
# Create at: https://github.com/settings/tokens → Generate new token (classic)
# Scope needed: (none for public repos — only public_repo if you need private)
# Without this:     60 requests/hour (IP-based)
# With this token: 5,000 requests/hour
# ✅ HIGHLY RECOMMENDED for development
VITE_GITHUB_PERSONAL_ACCESS_TOKEN=
